# Supabase — SPEC §2 (Postgres + Auth + Storage + RLS). Région UE (SPEC §8, RGPD).
# Créez un projet sur https://supabase.com puis reportez les valeurs ci-dessous.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Fournisseurs à l'usage, encapsulés derrière lib/*/… (SPEC §2.1).
# Laissés vides -> implémentations "noop" de développement.
TELEPHONY_PROVIDER=
VOICE_RUNTIME=

# Agent vocal Retell AI (webhook /api/voice). Clé serveur uniquement.
# RETELL_API_KEY = clé API Retell (badge « webhook ») : sert à vérifier la
# signature X-Retell-Signature des requêtes entrantes.
RETELL_API_KEY=
# Dépannage : mettre à 1 pour ignorer temporairement la vérification de signature.
# RETELL_SKIP_VERIFY=
# Org de repli quand le numéro appelé n'est pas encore rattaché (tests).
# ALLOCHANTIER_DEFAULT_ORG_ID=

# Écriture en base depuis le webhook vocal (contourne la RLS — serveur only).
SUPABASE_SERVICE_ROLE_KEY=

# Clés serveur uniquement (jamais exposées au navigateur) — à renseigner plus tard.
# ANTHROPIC_API_KEY=
# STRIPE_SECRET_KEY=
